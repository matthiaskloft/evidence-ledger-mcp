{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/matthiaskloft/evidence-ledger-schema/schema-v0.5.1/evidence-ledger.schema.json",
  "title": "Evidence ledger record (v0.5.1)",
  "description": "One record links a claim to a reference passage, analysis result, or implementation. See README.md for ledger file shapes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "claim_id",
    "claim",
    "claim_type",
    "contestable",
    "anchor",
    "key",
    "relation",
    "retrieved_via",
    "provenance"
  ],
  "dependentRequired": {
    "quote_prefix": [
      "quote"
    ],
    "quote_suffix": [
      "quote"
    ],
    "importance_reason": [
      "importance"
    ],
    "quote_focus": [
      "quote"
    ]
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "work"
      ],
      "description": "Ledger-level metadata. In JSON or YAML: {\"ledger\": header, \"records\": [...]}; in JSON Lines: the first line, {\"ledger\": header}.",
      "properties": {
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Version of this schema the records follow"
        },
        "work": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "type"
          ],
          "description": "The work whose citations this ledger records",
          "properties": {
            "title": {
              "$ref": "#/$defs/text"
            },
            "type": {
              "enum": [
                "manuscript",
                "software",
                "dataset",
                "other"
              ]
            },
            "location": {
              "$ref": "#/$defs/text",
              "description": "File, repository or URL of the work"
            }
          }
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "created": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "notes": {
          "$ref": "#/$defs/text",
          "description": "Free text about the ledger as a whole. Exported with the ledger: never paste source text here"
        },
        "level": {
          "enum": [
            "full",
            "masked",
            "locator"
          ],
          "description": "Export level; omitted for a private working ledger"
        },
        "max_words": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 25,
          "description": "Word budget for masked exports; null preserves default masking"
        }
      },
      "dependentRequired": {
        "max_words": [
          "level"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "max_words"
            ],
            "properties": {
              "max_words": {
                "type": "integer"
              }
            }
          },
          "then": {
            "properties": {
              "level": {
                "const": "masked"
              }
            }
          }
        }
      ]
    },
    "file_path": {
      "$ref": "#/$defs/text",
      "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*://)",
      "description": "Local file path, absolute or relative to the ledger file. Use url for remote files."
    },
    "artifact_url": {
      "type": "string",
      "pattern": "^https://[^/\\s?#]+(?:[/?#]\\S*)?(?![\\s\\S])",
      "description": "HTTPS link identifying a specific file; prefer an immutable revision. Hash the file contents, not a hosting service's HTML wrapper."
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "locator"
      ],
      "oneOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/file_path"
        },
        "url": {
          "$ref": "#/$defs/artifact_url"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "locator": {
          "$ref": "#/$defs/text"
        }
      },
      "description": "Primary evidence file, identified by exactly one of path or url. sha256 hashes exact file bytes; locator identifies a result or code symbol and lines."
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^R-[0-9]{4,}$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^C-[0-9]{4,}$"
    },
    "claim": {
      "$ref": "#/$defs/text"
    },
    "claim_type": {
      "enum": [
        "empirical",
        "definition",
        "method",
        "background"
      ],
      "description": "Descriptive only; contestable decides which evidence is required"
    },
    "importance": {
      "enum": [
        "critical",
        "substantial",
        "supporting"
      ],
      "description": "Dependence of this work on the claim; omitted means unassessed. Records sharing a claim_id must agree. Sets a minimum review depth without lowering the project default."
    },
    "importance_reason": {
      "$ref": "#/$defs/text",
      "description": "Why the work depends on this claim to the stated degree; optional, requires importance"
    },
    "contestable": {
      "type": "boolean",
      "default": true,
      "description": "true = full evidence required (Moravcsik's active citation). Defaults to true; setting false needs contestable_reason"
    },
    "contestable_reason": {
      "$ref": "#/$defs/text",
      "description": "Why the claim needs no full evidence, e.g. uncontested background"
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "marker"
          ]
        },
        {
          "required": [
            "exact"
          ]
        }
      ],
      "properties": {
        "marker": {
          "$ref": "#/$defs/text"
        },
        "exact": {
          "$ref": "#/$defs/text"
        },
        "prefix": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        }
      }
    },
    "key": {
      "$ref": "#/$defs/text",
      "description": "Citation key for a reference, or a local identifier for an analysis or implementation."
    },
    "doi": {
      "type": "string",
      "pattern": "^10\\.[0-9]{4,}/\\S+$"
    },
    "isbn": {
      "type": "string",
      "pattern": "^[0-9Xx -]{10,17}$"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://\\S+$",
      "description": "Stable link to a published resource, e.g. a repository or archive"
    },
    "no_identifier_reason": {
      "$ref": "#/$defs/text",
      "description": "Why the source has no DOI, ISBN or URL, e.g. internal document"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "page"
          ]
        },
        {
          "required": [
            "section"
          ]
        },
        {
          "required": [
            "figure"
          ]
        },
        {
          "required": [
            "table"
          ]
        }
      ],
      "properties": {
        "page": {
          "type": [
            "integer",
            "string"
          ],
          "minLength": 1
        },
        "section": {
          "$ref": "#/$defs/text"
        },
        "figure": {
          "$ref": "#/$defs/text"
        },
        "table": {
          "$ref": "#/$defs/text"
        },
        "chunk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "sha256"
          ],
          "description": "Lookup hint into the full-text index (zotero-fulltext); a stale hint falls back to search. Dropped from exports.",
          "properties": {
            "attachment": {
              "$ref": "#/$defs/text",
              "description": "Attachment key, when the citation key has several"
            },
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "quote": {
      "$ref": "#/$defs/text",
      "description": "Exact reference passage, result excerpt (including numbers or table rows), or code excerpt. Never paraphrase the evidence."
    },
    "quote_prefix": {
      "$ref": "#/$defs/text",
      "description": "Source text right before the quote; tells repeated occurrences apart (W3C TextQuoteSelector)"
    },
    "quote_suffix": {
      "$ref": "#/$defs/text",
      "description": "Source text right after the quote"
    },
    "quote_hash": {
      "type": "string",
      "pattern": "^sha256-n[0-9]+:[0-9a-f]{64}$",
      "description": "SHA-256 of UTF-8 normalized quote. New hashes use n2: Unicode NFKC, casefold, NFKC again, keep only letters and digits. Legacy n1 omits the second NFKC and remains checkable."
    },
    "relation": {
      "enum": [
        "supports",
        "partially_supports",
        "background",
        "method",
        "contrasts"
      ]
    },
    "justification": {
      "$ref": "#/$defs/text"
    },
    "note": {
      "$ref": "#/$defs/text",
      "description": "Free-text comment on this record. Exported with the ledger: never paste source text here; quotes belong in quote"
    },
    "retrieved_via": {
      "enum": [
        "zotero-fulltext",
        "pdf",
        "web",
        "human",
        "memory",
        "analysis_output",
        "source_code"
      ]
    },
    "found_via": {
      "type": "object",
      "required": [
        "route"
      ],
      "additionalProperties": false,
      "properties": {
        "route": {
          "enum": [
            "memory",
            "web_search",
            "database_search",
            "cited_in",
            "coauthor",
            "other"
          ]
        },
        "source": {
          "type": "string",
          "description": "Cite key or DOI of the citing reference, search query, or note"
        }
      }
    },
    "zotero_link": {
      "type": "string",
      "pattern": "^zotero://\\S+$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_type",
        "by",
        "date"
      ],
      "properties": {
        "by_type": {
          "enum": [
            "agent",
            "human"
          ]
        },
        "by": {
          "$ref": "#/$defs/text",
          "description": "Name of the person, or of the agent tool (e.g. Claude Code)"
        },
        "model": {
          "$ref": "#/$defs/text",
          "description": "Model and version; required when by_type is agent"
        },
        "manuscript_rev": {
          "$ref": "#/$defs/text"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "if": {
        "properties": {
          "by_type": {
            "const": "agent"
          }
        }
      },
      "then": {
        "required": [
          "model"
        ]
      }
    },
    "withdrawn": {
      "$ref": "#/$defs/text",
      "description": "Set when the authors withdraw this citation: the reason. Review status (open, checked, disputed, unverifiable) is derived from the review log, not stored here"
    },
    "derived_from": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^R-[0-9]{4,}$"
      },
      "description": "Optional IDs of evidence records used by this analysis. References must exist in this ledger and form an acyclic graph without self references."
    },
    "quote_focus": {
      "$ref": "#/$defs/text",
      "description": "Phrase carrying the claim within quote; must occur exactly once, cover whole whitespace-delimited words, and contain at most 25 words. Source text: removed from masked and locator exports."
    },
    "evidence_type": {
      "enum": [
        "reference",
        "analysis_output",
        "source_code"
      ],
      "default": "reference",
      "description": "Optional; omission means reference. Choose by what supports the claim, regardless of file format: what a source states, a computed or observed result, or the implementation itself."
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report"
      ],
      "properties": {
        "report": {
          "$ref": "#/$defs/artifact"
        },
        "script": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "path"
              ]
            },
            {
              "required": [
                "url"
              ]
            }
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/file_path"
            },
            "url": {
              "$ref": "#/$defs/artifact_url"
            },
            "locator": {
              "$ref": "#/$defs/text",
              "description": "Optional location within the generating script, such as a function, notebook cell, or line range. Location only, never a code excerpt."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            }
          }
        }
      },
      "description": "Primary report or output and optional generating script. Prefer a rendered report; when script is omitted, the report must identify its source script."
    },
    "source_code": {
      "$ref": "#/$defs/artifact",
      "description": "Implementation file; locator names the symbol and optionally lines. Exact byte hash pins the file."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contestable": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "quote",
          "quote_hash",
          "justification"
        ]
      },
      "else": {
        "required": [
          "contestable_reason"
        ]
      }
    },
    {
      "if": {
        "required": [
          "evidence_type"
        ],
        "properties": {
          "evidence_type": {
            "const": "analysis_output"
          }
        }
      },
      "then": {
        "required": [
          "analysis"
        ],
        "properties": {
          "source_code": false,
          "locator": false
        }
      },
      "else": {
        "properties": {
          "analysis": false,
          "derived_from": false
        }
      }
    },
    {
      "if": {
        "required": [
          "evidence_type"
        ],
        "properties": {
          "evidence_type": {
            "const": "source_code"
          }
        }
      },
      "then": {
        "required": [
          "source_code"
        ],
        "properties": {
          "locator": false
        }
      },
      "else": {
        "properties": {
          "source_code": false
        }
      }
    },
    {
      "if": {
        "not": {
          "anyOf": [
            {
              "required": [
                "evidence_type"
              ],
              "properties": {
                "evidence_type": {
                  "const": "analysis_output"
                }
              }
            },
            {
              "required": [
                "evidence_type"
              ],
              "properties": {
                "evidence_type": {
                  "const": "source_code"
                }
              }
            }
          ]
        }
      },
      "then": {
        "allOf": [
          {
            "anyOf": [
              {
                "required": [
                  "doi"
                ]
              },
              {
                "required": [
                  "isbn"
                ]
              },
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "no_identifier_reason"
                ]
              }
            ]
          },
          {
            "if": {
              "properties": {
                "contestable": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "locator"
              ]
            }
          }
        ]
      }
    }
  ]
}
